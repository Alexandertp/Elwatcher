@model IEnumerable<ElWatcher.Models.Co2Observation>

<h1>CO2-udledning</h1>

<table class="table">
    <thead>
    <tr>
        <th>Område</th>
        <th>Emissionsværdi</th>
        <th>Tidspunkt</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.PriceArea</td>
            <td>@item.CO2Emission</td>
            <td>@item.Minutes5DK</td>
        </tr>
    }
    </tbody>
</table>